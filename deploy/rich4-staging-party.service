[Unit]
Description=Rich4 staging private PeerServer and ephemeral TURN configuration
After=network.target

[Service]
User=devspace
Group=devspace
WorkingDirectory=/srv/devspace/repos/rich4-runtime/control/party-runtime
EnvironmentFile=/srv/devspace/repos/rich4-runtime/state/turn-staging.env
ExecStart=/srv/devspace/runtime/node/bin/node runtime.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
